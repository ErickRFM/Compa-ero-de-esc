# Normalize line endings so the same files behave identically on every OS.

* text=auto eol=lf

# Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper scripts must keep LF to run on Unix CI.
gradlew text eol=lf

# Binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary
*.jks binary
