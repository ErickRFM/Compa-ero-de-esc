<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{requestId:-no-request-id}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Ktor and the Mongo driver are chatty at INFO; keep the signal readable. -->
    <logger name="io.ktor" level="INFO"/>
    <logger name="org.mongodb.driver" level="WARN"/>
    <logger name="org.companerodeescuela" level="DEBUG"/>

    <logger name="Application" level="DEBUG"/>
</configuration>
