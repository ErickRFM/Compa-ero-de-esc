# ---------------------------------------------------------------------------
# Compañero de Escuela - local environment template
#
# Copy to `.env` (git-ignored) and fill in real values:
#   cp .env.example .env        # Linux / macOS / WSL
#   Copy-Item .env.example .env # PowerShell
#
# The API reads plain environment variables; `.env` is only a convenience for
# shells and IDE run configurations that load it. Never commit a filled copy.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# One of: local, development, staging, production.
# Anything other than local/development refuses to boot with mock providers.
APP_ENV=local

# Interface and port the Ktor server binds to.
API_HOST=127.0.0.1
API_PORT=8080

# Reported by GET /version. Override in CI to tag a build.
APP_VERSION=0.0.0-dev

# --- Database --------------------------------------------------------------
# Logical database name. Required.
MONGODB_DATABASE=companero_dev

# Connection string for MongoDB Atlas or a local mongod.
# Leave blank to boot without a database: /health reports it as "degraded" and
# /ready answers 503. This is the default for a first local run.
#
# Example shape (Atlas) - never paste a real credential into this file:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=

# Driver timeouts, in milliseconds. Keep them short so a bad DSN fails fast.
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Authentication --------------------------------------------------------
# Optional while APP_ENV is local or development; REQUIRED for production.
# Minimum 32 characters. Generate one with:
#   pwgen -s 48   |   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=companero-de-escuela
JWT_AUDIENCE=companero-android

# --- Attendance QR ---------------------------------------------------------
# Separate HMAC signing secret for short-lived attendance QR evidence.
# Optional until the QR phase is enabled. Never reuse JWT_SECRET.
# Minimum 32 characters when configured.
ATTENDANCE_GRACE_MINUTES=5
ATTENDANCE_QR_SECRET=

# --- School-day presence ---------------------------------------------------
# Optional feature gate. When configured, students must start their school day
# by scanning the institutional wall QR while connected to an authorized
# school Wi-Fi network before class attendance can be confirmed.
#
# Store only the SHA-256 digest of the QR payload, never the raw QR token.
# Example:
#   python -c "import hashlib;print(hashlib.sha256(b'my-random-wall-token').hexdigest())"
SCHOOL_PRESENCE_QR_SHA256=

# Comma-separated allowlists. Configure at least one when presence is enabled.
# BSSID is preferred when the access-point inventory is stable.
SCHOOL_WIFI_SSIDS=
SCHOOL_WIFI_BSSIDS=

# --- Android (client side) -------------------------------------------------
# Base URL the debug build talks to. 10.0.2.2 is the host machine as seen from
# the Android emulator. On a physical device use the machine's LAN address.
# Do not commit a real LAN address.
COMPANERO_API_BASE_URL=http://10.0.2.2:8080/

# Release builds never inherit the debug/development backend. If omitted, the
# release APK compiles against an intentionally unreachable HTTPS placeholder.
# Set this only to the production/staging Companion API you intend to ship.
COMPANERO_RELEASE_API_BASE_URL=https://invalid.invalid/
